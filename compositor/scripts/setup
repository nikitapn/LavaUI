#!/usr/bin/env python3
"""First-run (and re-run) setup for the Lava compositor.

A friend launching this on a hybrid laptop should not have to know that
the connectors hang off one DRM card and the Vulkan device off another.
This enumerates the GPUs, the screens on each, and the usual keyboard
layouts, then writes `~/.config/lava/lava.conf`.

    start-lava-compositor setup     # this file
    start-lava-compositor           # runs this first if the file has no GPU

No third-party modules. A numbered menu rather than curses, so it works
over a serial console and in a tiny TTY the same way it works in kitty.
"""

from __future__ import annotations

import os
import re
import sys
from dataclasses import dataclass, field
from pathlib import Path

PCI_VENDORS = {
    0x10DE: "NVIDIA",
    0x1002: "AMD",
    0x8086: "Intel",
    0x1A03: "ASPEED",
    0x1234: "QEMU",
}

COMMON_LAYOUTS = [
    ("us", "English (US)"),
    ("gb", "English (UK)"),
    ("de", "German"),
    ("fr", "French"),
    ("es", "Spanish"),
    ("it", "Italian"),
    ("pt", "Portuguese"),
    ("br", "Portuguese (Brazil)"),
    ("ru", "Russian"),
    ("ua", "Ukrainian"),
    ("pl", "Polish"),
    ("cz", "Czech"),
    ("hu", "Hungarian"),
    ("se", "Swedish"),
    ("no", "Norwegian"),
    ("dk", "Danish"),
    ("fi", "Finnish"),
    ("et", "Estonian"),
    ("nl", "Dutch"),
    ("be", "Belgian"),
    ("tr", "Turkish"),
    ("gr", "Greek"),
    ("il", "Hebrew"),
    ("ara", "Arabic"),
    ("jp", "Japanese"),
]

SWITCHES = [
    ("", "None — one layout only"),
    ("grp:alt_shift_toggle", "Alt+Shift"),
    ("grp:ctrl_shift_toggle", "Ctrl+Shift"),
    ("grp:ctrls_toggle", "Both Ctrl keys together"),
    ("grp:win_space_toggle", "Super+Space"),
    ("grp:lctrl_toggle", "Left Ctrl"),
    ("grp:rctrl_toggle", "Right Ctrl"),
    ("grp:caps_toggle", "Caps Lock"),
    ("grp:shifts_toggle", "Both Shifts together"),
]


# ─── terminal ──────────────────────────────────────────────────────────────

def _tty() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


def _c(code: str, text: str) -> str:
    if not _tty() or os.environ.get("NO_COLOR"):
        return text
    return f"\033[{code}m{text}\033[0m"


def bold(t: str) -> str:
    return _c("1", t)


def dim(t: str) -> str:
    return _c("2", t)


def accent(t: str) -> str:
    return _c("36", t)


def warn(t: str) -> str:
    return _c("33", t)


def banner(title: str) -> None:
    bar = "─" * max(48, len(title) + 8)
    print()
    print(accent(bar))
    print(accent(f"  {title}"))
    print(accent(bar))
    print()


def ask(prompt: str, default: str | None = None) -> str:
    suffix = f" [{default}]" if default else ""
    try:
        raw = input(f"  {prompt}{suffix}: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        sys.exit(1)
    return raw if raw else (default or "")


def choose(title: str, options: list[str], default: int = 1) -> int:
    """1-based index into `options`."""
    print(bold(title))
    for i, label in enumerate(options, 1):
        mark = accent("▸") if i == default else " "
        print(f"  {mark} {accent(str(i))}. {label}")
    print()
    while True:
        raw = ask("Choice", str(default))
        if raw.isdigit():
            n = int(raw)
            if 1 <= n <= len(options):
                return n
        print(warn(f"  Type a number from 1 to {len(options)}."))


# ─── hardware ──────────────────────────────────────────────────────────────

@dataclass
class Connector:
    name: str
    status: str


@dataclass
class Gpu:
    card: str
    card_path: str
    render_path: str
    driver: str
    vendor_id: int
    device_id: int
    vendor: str
    product: str
    connectors: list[Connector] = field(default_factory=list)

    @property
    def connected(self) -> list[Connector]:
        return [c for c in self.connectors if c.status == "connected"]

    def headline(self) -> str:
        who = self.product or self.vendor or self.driver
        if self.product and self.vendor and self.vendor.lower() not in self.product.lower():
            who = f"{self.vendor} {self.product}"
        screens = ", ".join(c.name for c in self.connected) or "no screen plugged in"
        return f"{who}  ({self.card_path})  —  {screens}"


def _read(path: Path) -> str:
    try:
        return path.read_text().strip()
    except OSError:
        return ""


def _pci_int(text: str) -> int:
    text = text.strip()
    if text.startswith("0x") or text.startswith("0X"):
        text = text[2:]
    try:
        return int(text, 16)
    except ValueError:
        return 0


def _lspci_name(pci_path: Path) -> str:
    # /sys/devices/pci.../0000:01:00.0
    slot = pci_path.name
    if not re.match(r"[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-9a-fA-F]", slot):
        return ""
    import shutil
    import subprocess

    if shutil.which("lspci") is None:
        return ""
    try:
        # sysfs name is 0000:01:00.0; lspci accepts that or 01:00.0.
        out = subprocess.check_output(
            ["lspci", "-s", slot, "-nn"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""
    # "01:00.0 VGA compatible controller [0300]: NVIDIA Corporation GA106M
    #  [GeForce RTX 3060 Mobile / Max-Q] [10de:2520] (rev a1)"
    line = out.strip()
    if ": " not in line:
        return ""
    rest = line.split(": ", 1)[1]
    rest = re.sub(r"\s*\(rev [^)]+\)\s*$", "", rest)
    rest = re.sub(r"\s*\[[0-9a-fA-F]{4}:[0-9a-fA-F]{4}\]\s*$", "", rest)
    # Prefer the marketing name in brackets when the vendor put one there.
    names = [
        m.group(1)
        for m in re.finditer(r"\[([^]]+)\]", rest)
        if not re.fullmatch(r"[0-9a-fA-F]{4}", m.group(1))
    ]
    if names:
        return names[-1].strip()
    return rest.strip()


def enumerate_gpus() -> list[Gpu]:
    drm = Path("/sys/class/drm")
    if not drm.is_dir():
        return []

    renders: dict[str, str] = {}
    for node in sorted(drm.glob("renderD*")):
        device = (node / "device").resolve()
        renders[str(device)] = f"/dev/dri/{node.name}"

    gpus: list[Gpu] = []
    for card in sorted(drm.glob("card[0-9]")):
        if not re.fullmatch(r"card\d+", card.name):
            continue
        dev = (card / "device").resolve()
        uevent = _read(card / "device" / "uevent")
        driver = ""
        for line in uevent.splitlines():
            if line.startswith("DRIVER="):
                driver = line.split("=", 1)[1]
        vendor_id = _pci_int(_read(card / "device" / "vendor"))
        device_id = _pci_int(_read(card / "device" / "device"))
        vendor = PCI_VENDORS.get(vendor_id, driver or "GPU")
        product = _lspci_name(dev) or vendor
        connectors: list[Connector] = []
        for conn in sorted(Path("/sys/class/drm").glob(f"{card.name}-*")):
            status = _read(conn / "status") or "unknown"
            # card0-DP-3 → DP-3
            name = conn.name.split("-", 1)[1]
            connectors.append(Connector(name=name, status=status))
        gpus.append(
            Gpu(
                card=card.name,
                card_path=f"/dev/dri/{card.name}",
                render_path=renders.get(str(dev), ""),
                driver=driver,
                vendor_id=vendor_id,
                device_id=device_id,
                vendor=vendor,
                product=product,
                connectors=connectors,
            )
        )
    return gpus


def config_path() -> Path:
    if explicit := os.environ.get("LAVA_CONFIG"):
        return Path(explicit).expanduser()
    xdg = os.environ.get("XDG_CONFIG_HOME", "")
    if xdg:
        return Path(xdg) / "lava" / "lava.conf"
    return Path.home() / ".config" / "lava" / "lava.conf"


def config_has_gpu(path: Path) -> bool:
    if not path.is_file():
        return False
    section = ""
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            continue
        if not line or line.startswith("#"):
            continue
        if section == "core" and line.split("=", 1)[0].strip() in {
            "drm-device",
            "drm-devices",
        }:
            return True
    return False


# ─── config write ──────────────────────────────────────────────────────────

def upsert(path: Path, values: dict[str, dict[str, str]]) -> None:
    """Surgical write: replace live keys, append missing ones, keep comments."""
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = path.read_text().splitlines() if path.is_file() else []
    if lines and lines[-1] != "":
        lines.append("")

    def section_of(line: str) -> str | None:
        t = line.strip()
        if len(t) >= 2 and t[0] == "[" and t[-1] == "]":
            return t[1:-1].strip()
        return None

    def key_of(line: str) -> str | None:
        t = line.strip()
        if not t or t[0] == "#":
            return None
        if "=" not in t:
            return None
        return t.split("=", 1)[0].strip()

    pending = {sec: dict(keys) for sec, keys in values.items()}

    i = 0
    current = ""
    while i < len(lines):
        header = section_of(lines[i])
        if header is not None:
            current = header
            i += 1
            continue
        key = key_of(lines[i])
        if key and current in pending and key in pending[current]:
            lines[i] = f"{key} = {pending[current].pop(key)}"
        i += 1

    for section, keys in pending.items():
        if not keys:
            continue
        # Find the last line of an existing section to append into.
        last = -1
        current = ""
        for idx, line in enumerate(lines):
            header = section_of(line)
            if header is not None:
                current = header
                continue
            if current == section:
                last = idx
        block = [f"{k} = {v}" for k, v in keys.items()]
        if last >= 0:
            lines[last + 1 : last + 1] = block
        else:
            if lines and lines[-1].strip():
                lines.append("")
            lines.append(f"[{section}]")
            lines.extend(block)
            lines.append("")

    path.write_text("\n".join(lines).rstrip() + "\n")


def write_fresh(path: Path, core: dict[str, str], keyboard: dict[str, str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    parts = [
        "# Written by `start-lava-compositor setup`. Edit by hand or run setup",
        "# again. `kill -HUP` reloads keyboard and screens; GPU changes need",
        "# a restart.",
        "",
        "[core]",
        "# vulkan is the one this compositor is built for.",
        f"renderer = {core.get('renderer', 'vulkan')}",
        "# Card(s) the connectors hang off. First is primary.",
        f"drm-device = {core['drm-device']}",
    ]
    if core.get("render-device"):
        parts += [
            "# Card that draws, if it is not the first drm-device.",
            f"render-device = {core['render-device']}",
        ]
    parts += [
        "",
        "[keyboard]",
        f"layout = {keyboard['layout']}",
        f"options = {keyboard.get('options', '')}",
        f"mod-key = {keyboard.get('mod-key', 'super')}",
        "",
        "[appearance]",
        "corner-radius = 10",
        "shadow-blur = 24",
        "shadow-opacity = 0.35",
        "shadow-offset-y = 4",
        "",
    ]
    path.write_text("\n".join(parts))


# ─── wizard ────────────────────────────────────────────────────────────────

def pick_gpus(gpus: list[Gpu]) -> tuple[list[Gpu], Gpu | None]:
    banner("Graphics")
    if not gpus:
        print(warn("  No DRM cards under /sys/class/drm. A VM or a missing"))
        print(warn("  driver will do that. Setup will leave the GPU keys empty"))
        print(warn("  and wlroots will pick whatever it can."))
        print()
        return [], None

    print("  Each card can only light the screens plugged into *it*.")
    print("  On a hybrid laptop the built-in panel and an HDMI port often")
    print("  sit on different cards — pick both if you want both lit.")
    print()
    for gpu in gpus:
        print(f"  {bold(gpu.product or gpu.vendor)}")
        print(f"    {dim(gpu.card_path + '  driver=' + (gpu.driver or '?'))}")
        if gpu.connectors:
            for conn in gpu.connectors:
                flag = accent("connected") if conn.status == "connected" else dim(conn.status)
                print(f"    {conn.name}: {flag}")
        print()

    if len(gpus) == 1:
        print(dim(f"  Only one GPU — using {gpus[0].card_path}."))
        print()
        return gpus, gpus[0]

    options = [g.headline() for g in gpus]
    # Dual: each card as primary, plus each single card.
    both_choices: list[tuple[str, list[Gpu]]] = []
    for first in gpus:
        rest = [g for g in gpus if g is not first]
        order = [first] + rest
        both_choices.append(
            (
                "Both screens, " + first.vendor + " draws  ("
                + ":".join(g.card_path for g in order)
                + ")",
                order,
            )
        )

    labels = [c[0] for c in both_choices] + [
        f"Only {g.headline()}" for g in gpus
    ]
    # Prefer "both, first card with a connected output" — laptop + monitor.
    default = 1
    for i, gpu in enumerate(gpus, 1):
        if any(c.name.startswith("eDP") and c.status == "connected" for c in gpu.connectors):
            # AMD/Intel iGPU as primary is the usual laptop default.
            default = i
            break
    choice = choose("Which screens should come up?", labels, default=default)
    if choice <= len(both_choices):
        order = both_choices[choice - 1][1]
    else:
        order = [gpus[choice - 1 - len(both_choices)]]

    render: Gpu | None = order[0]
    if len(order) > 1 or any(g.render_path for g in gpus):
        print()
        r_labels = [
            f"Same as the display card ({order[0].product or order[0].vendor})"
        ]
        extras = [g for g in gpus if g.render_path]
        r_labels.extend(f"Draw on {g.product or g.vendor}  ({g.render_path})" for g in extras)
        r = choose(
            "Which GPU should draw? (The other one can still show the image.)",
            r_labels,
            default=1,
        )
        render = None if r == 1 else extras[r - 2]
    return order, render


def pick_keyboard() -> tuple[str, str, str]:
    banner("Keyboard")
    labels = [f"{name}  ({code})" for code, name in COMMON_LAYOUTS]
    labels.append("Other — type an xkb code (us, de, ru, …)")
    i = choose("Primary layout", labels, default=1)
    if i == len(labels):
        code = ask("xkb layout code", "us").lower()
        primary = (code, code)
    else:
        primary = COMMON_LAYOUTS[i - 1]

    print()
    extra = ask("Second layout for switching, or empty for none", "").strip().lower()
    layouts = [primary[0]]
    if extra:
        # Accept "ru" or a number from the list.
        if extra.isdigit() and 1 <= int(extra) <= len(COMMON_LAYOUTS):
            extra = COMMON_LAYOUTS[int(extra) - 1][0]
        if extra != primary[0]:
            layouts.append(extra)

    switch = ""
    if len(layouts) > 1:
        print()
        s = choose(
            "Key that cycles those layouts",
            [label for _, label in SWITCHES],
            default=2,  # Alt+Shift
        )
        switch = SWITCHES[s - 1][0]
        if not switch:
            print(warn("  No switch key — both layouts are in the keymap but"))
            print(warn("  you will need to add a grp: option later to cycle."))
    print()
    m = choose(
        "Desktop shortcut key (close window, maximize, drag)",
        ["Super (Win / Meta) — recommended on a real session", "Alt"],
        default=1,
    )
    mod = "super" if m == 1 else "alt"
    return ",".join(layouts), switch, mod


def summarize(
    path: Path,
    cards: list[Gpu],
    render: Gpu | None,
    layout: str,
    switch: str,
    mod: str,
) -> dict[str, dict[str, str]]:
    banner("Summary")
    drm = ":".join(g.card_path for g in cards) if cards else ""
    render_dev = ""
    if render is not None and render.render_path:
        if not cards or render is not cards[0]:
            render_dev = render.render_path
    print(f"  Config file   {path}")
    print(f"  Displays      {drm or '(wlroots default)'}")
    print(f"  Draws on      {render_dev or '(same as displays)'}")
    print(f"  Layouts       {layout or 'xkb default'}")
    print(f"  Switch        {switch or 'none'}")
    print(f"  Shortcuts     {mod}")
    print()
    core = {"renderer": "vulkan"}
    if drm:
        core["drm-device"] = drm
    if render_dev:
        core["render-device"] = render_dev
    keyboard = {"layout": layout, "mod-key": mod}
    if switch:
        keyboard["options"] = switch
    else:
        keyboard["options"] = ""
    return {"core": core, "keyboard": keyboard}


def run_wizard() -> int:
    banner("Lava compositor setup")
    print("  This writes the machine-specific bits of lava.conf:")
    print("  which GPU lights which screen, and how the keyboard is laid out.")
    print("  You can run it again later; it edits those keys and leaves the")
    print("  rest of the file alone.")
    print()

    gpus = enumerate_gpus()
    cards, render = pick_gpus(gpus)
    layout, switch, mod = pick_keyboard()
    path = config_path()
    values = summarize(path, cards, render, layout, switch, mod)

    confirm = ask("Write this and continue", "Y").lower()
    if confirm not in {"", "y", "yes"}:
        print(dim("  Nothing written."))
        return 1

    if path.is_file():
        upsert(path, values)
        print(f"  Updated {path}")
    else:
        write_fresh(path, values["core"], values["keyboard"])
        print(f"  Created {path}")
    print()
    print("  GPU changes apply the next time the compositor starts.")
    print("  Keyboard changes also apply on  kill -HUP  of a running one.")
    return 0


def needed() -> bool:
    """True when a session start should stop and ask."""
    gpus = enumerate_gpus()
    path = config_path()
    if not path.is_file():
        return True
    if len(gpus) > 1 and not config_has_gpu(path):
        return True
    return False


def main(argv: list[str]) -> int:
    if any(a in {"-h", "--help"} for a in argv):
        print(__doc__)
        return 0
    if argv and argv[0] == "--needed":
        return 0 if needed() else 1
    if argv and argv[0] == "--list":
        for gpu in enumerate_gpus():
            print(gpu.headline())
            for conn in gpu.connectors:
                print(f"    {conn.name}: {conn.status}")
        return 0
    if not _tty():
        print("setup: need a terminal (stdin is not a tty)", file=sys.stderr)
        return 2
    return run_wizard()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
