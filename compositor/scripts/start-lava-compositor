#!/usr/bin/env sh
# Start a real DRM session, or run first-time setup.
#
#   start-lava-compositor           start (setup first if the GPU is unset)
#   start-lava-compositor setup     just the TUI; writes ~/.config/lava/lava.conf
#
# GPU devices come from lava.conf [core], not from this script. Hardcoding
# card0 here is how a hybrid laptop always came up on the wrong GPU.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
cd "$ROOT"

SETUP="$SCRIPT_DIR/setup"
COMPOSITOR="${LAVA_COMPOSITOR:-$ROOT/build-release/compositor/compositor}"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

if [ "${1:-}" = "setup" ]; then
  exec python3 "$SETUP"
fi

if [ ! -x "$COMPOSITOR" ] && [ ! -f "$COMPOSITOR" ]; then
  echo "start-lava-compositor: no compositor at $COMPOSITOR" >&2
  echo "  meson compile -C build-release   or set LAVA_COMPOSITOR=" >&2
  exit 1
fi

# A hybrid laptop with no drm-device in the file would otherwise come up
# on whichever card enumerated first — often the one with no panel.
if [ -t 0 ] && python3 "$SETUP" --needed; then
  echo "Lava has not been set up on this machine yet."
  python3 "$SETUP" || exit 1
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# The panel, dock, launcher and everything the launcher starts are found by
# `ShellSupervisor::programPath`, which searches `.build/debug` *before*
# `.build/release` when this is unset. A release session left to itself comes
# up running debug components and says nothing about it.
export LAVA_SHELL_DIR="${LAVA_SHELL_DIR:-$ROOT/.build/release}"

# drm,libinput is a seat session. Do not set WLR_DRM_DEVICES here: the
# compositor reads [core] from lava.conf before it creates the backend.
export WLR_BACKENDS="${WLR_BACKENDS:-drm,libinput}"
export WLR_RENDERER="${WLR_RENDERER:-vulkan}"
export LAVA_CLIENT=1

# Debugging switches, off by default. Uncomment what you need.
#export LAVA_FRAME_PROBE=1            # per-surface frame cost, gaps, stalls
#export LAVA_SCANOUT_PROBE=1          # direct-scanout decision and fence state
#export LAVA_VRAM_STATS=1             # GPU memory report every 10s (=verbose for every allocation)
#export WLR_LOG=debug                 # wlroots + compositor debug logging (very chatty)
#export WLR_SCENE_DEBUG_DAMAGE=highlight   # highlight what each frame recomposites
#export LAVA_FULL_DAMAGE=1            # damage whole buffers; A/B for stale pixels
#export LAVA_BOOT_TRACE=1             # where the time before a client's first frame went
#export CANVAS_VK_VALIDATION=1        # Vulkan validation layers
#export LAVA_MSAA=2                   # cap multisampling (1/2/4/8)
#export LAVA_IMAGE_SPECULATION=0      # pin the dormant image cache off (1 = on)
#export LAVA_NO_AUTOSTART=1           # skip ~/.config/lava/autostart
#export LAVA_NO_SHELL=1               # do not start panel/dock/wallpaper

if [ -z "$SSH_AUTH_SOCK" ]; then
	eval "$(ssh-agent -s)"
fi

# tmpfs, so a session's logging never touches the disk. /tmp rather than
# $XDG_RUNTIME_DIR because systemd removes that when the last session ends —
# and a compositor that died *is* the session ending, which is exactly when
# the log still needs reading. Cleared on reboot, which is soon enough.
LAVA_LOG_FILE="${LAVA_LOG_FILE:-/tmp/lava-compositor-$(id -u).log}"

exec stdbuf -oL -eL "$COMPOSITOR" >"$LAVA_LOG_FILE" 2>&1
