# Lava compositor configuration.
#
# Copy to ~/.config/lava/lava.conf. Every setting here is a decision about the
# machine rather than about the program — which GPU, which screens, what the
# keyboard is — which is why none of them are compiled in.
#
# `kill -HUP $(pidof compositor)` re-reads this file. Screen modes, positions,
# scale and the keyboard layout take effect immediately. The GPU settings do
# not: they are read once, while the backend is being created, and changing
# which GPU a running compositor draws on would mean re-importing every buffer
# in the session.
#
# Anything unrecognised is logged and skipped, so a config written for a newer
# build still starts an older one.


[core]

# Which renderer: vulkan, gles2, pixman. Left unset, wlroots decides.
#
# Vulkan is the one to use here. On this hardware GLES2 fails outright on the
# NVIDIA card ("EGLImage not supported"), and pixman is software — dependable,
# and far too slow for a session.
renderer = vulkan

# Which card drives the screens — WLR_DRM_DEVICES. Not the fastest card: the
# one the connectors physically hang off. Check with
#
#     for c in /sys/class/drm/card*-*; do echo "$c: $(cat $c/status)"; done
#
# On this laptop:
#
#     card0  NVIDIA   DP-3 connected      <- the external monitor
#     card1  AMD      eDP-1 connected     <- the laptop panel
#
# so card0 lights the external screen and card1 lights the built-in one. One
# card, one set of screens. To drive both at once, list both — first is
# primary and does the rendering, the rest get their buffers copied to them:
#
#     drm-device = /dev/dri/card0:/dev/dri/card1
drm-device = /dev/dri/card0

# Which card *draws*, if that differs from the one presenting —
# WLR_RENDER_DRM_DEVICE. Only worth setting for render-on-one, present-on-
# another. Canvas follows this automatically: it pins its Vulkan device by
# matching the DRM node wlroots is using, so the compositor never ends up
# rendering LavaUI surfaces on a different GPU than it composites on.
# render-device = /dev/dri/renderD129

# Which screen hosts the panel and new windows. The connector name
# wlroots reports — the same name as the `[output …]` blocks below.
# Left unset, the screen at the layout origin is used (usually the
# leftmost). Unplugging it does not forget the name: another screen
# stands in until it comes back. LavaSettings writes this.
# primary-output = DP-3

# How the screens share the desktop. `extend` (the default) gives each
# screen its own piece of the layout; `mirror` shows the same picture
# on every screen. LavaSettings writes this.
# arrangement = extend


# One block per connector. The name is what wlroots calls it — run the
# compositor once and read the log, which lists every output it found together
# with the modes each one accepts.
#
# `[output *]` is the fallback for anything without a block of its own.

[output DP-3]
# WIDTHxHEIGHT@RATE. The rate is optional; without it, the fastest mode at
# that size wins. Write the rate as the monitor advertises it — 74.973 rather
# than 75 — though near misses are matched to the closest mode anyway.
mode = 1920x1080@74.973
position = 0,0
scale = 1
transform = normal
enabled = true

# The laptop panel, off by default here because the lid is usually shut.
# Enabling it needs card1 in drm-device above as well, or there is nothing
# driving that connector.
[output eDP-1]
enabled = false

[output *]
mode = preferred


[keyboard]

# xkb names, exactly as setxkbmap takes them. Empty means xkb's own default,
# which is a US layout on most installs. Two languages is a comma-separated
# list — `us,ru` — plus a `grp:` option, or the switch key has nothing to
# cycle. Picking one layout in Settings used to replace the other.
layout = us
# layout = us,ru
# variant = colemak
# options = grp:alt_shift_toggle,ctrl:nocaps
# model =
# rules =

# Repeat, in keys per second and milliseconds held before it starts.
repeat-rate = 25
repeat-delay = 600

# Which modifier the compositor's own shortcuts use (and mod+drag):
# alt (default) or super (the Win / Meta key).
# mod-key = alt


[shell]

# The desktop's own parts, started by the compositor and kept running.
#
# Not a choice of panel — these *are* this desktop's panel and dock, started
# the way Xwayland is. What you can do here is point them somewhere else or
# turn one off, which is what a developer running one under a debugger wants:
#
#     panel = off          # do not start it; run it by hand
#     dock  = /opt/bin/MyDock
#
# A bare name is looked for next to the compositor binary, then in this repo's
# SwiftPM build directory, then on PATH. `LAVA_NO_SHELL=1` in the environment
# turns the whole thing off for one run without editing this file.
#
# If one of them crashes it is restarted, with a delay that grows if it keeps
# happening and a point past which the compositor stops trying and says so. If
# one stops *drawing* while still running, it is restarted too — clients send
# a heartbeat from their frame loop, so a wedged panel is not mistaken for a
# quiet one.
panel = LavaTaskbar
dock = LavaDock


[theme]

# Which LavaUI Theme every client that uses system colours should wear:
# dark, light, or nebula. LavaSettings writes this; a SIGHUP reloads it
# and pushes the new name to every subscribed window.
name = dark


[appearance]

# How the desktop looks, as opposed to what the machine is — the odd section
# out in this file, and the one you should not need to edit: `LavaSettings`
# writes it, applying each change to the running compositor first and saving it
# here afterwards. Editing by hand still works, and still needs a SIGHUP.
#
# Values here are what that app writes back, so a hand edit survives it: it
# rewrites the keys it changes and leaves everything else, comments included,
# exactly where you put them.

# Window corner radius in pixels; 0 is square. Applies to what the compositor
# draws — LavaUI clients and the title bars above them. A Wayland client's own
# buffer is not ours to reshape, so those stay square.
corner-radius = 0

# How far the focused window's shadow reaches, in pixels; 0 turns shadows off.
# Only the focused window casts one, which is how the desktop says which window
# is active without tinting a border.
shadow-blur = 0

# Opacity directly under the window, 0…1, fading to nothing over the blur.
shadow-opacity = 0.35

# How far down the shadow is pushed. Light comes from above, and a shadow
# centred on its window reads as a glow instead.
shadow-offset-y = 4


[background]

# What the desktop is painted with, behind every window. Written by
# LavaSettings' Background page; editable here, and a SIGHUP applies it.

# solid or picture. `solid` is the mode that cannot fail — there is no file to
# be missing and nothing to decode.
mode = solid

# The desktop colour, as 0xrrggbb.
#
# Written with `0x` and not `#`, because a `#` starts a comment anywhere on a
# line in this file — `color = #0e131f` would parse as an empty value and the
# key would be dropped. LavaSettings accepts either spelling in its hex field
# and always writes this one.
#
# Meaningful in *both* modes. Under a picture this is what shows wherever the
# picture does not reach: the letterbox bars under `fit = fit`, the margins
# under `fit = center`, and the whole of any screen plugged in before the
# picture has been fitted to it.
color = 0x0e131f

# The picture, when mode = picture. A leading ~ is expanded. PNG, JPEG, BMP,
# GIF and TGA are read; SVG is not.
#
# A path that cannot be read is reported and skipped at startup, and the
# desktop comes up in the colour above rather than refusing to start. Over the
# control plane the same path is *refused* outright, leaving the previous
# background up — which is why a broken path never reaches this file.
# picture = ~/Pictures/wallpaper.png

# How the picture is placed on each screen. Applied per screen, so two
# monitors of different shapes each get their own crop:
#
#     fill      cover the screen, crop whichever axis overflows  (default)
#     fit       the whole picture, colour in the letterbox bars
#     stretch   cover the screen, ignoring the picture's shape
#     center    actual size, no scaling at all
fit = fill
