<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{title}}</title>
  {{#description}}<meta name="description" content="{{description}}" />{{/description}}
  {{#robots}}<meta name="robots" content="{{robots}}" />{{/robots}}
  {{#canonical}}<link rel="canonical" href="{{canonical}}" />{{/canonical}}
  {{! Link previews (Mastodon, Slack, Hacker News readers, …): the desktop
      screenshot on every page, since it says more than any one title. }}
  <meta property="og:site_name" content="{{brand}}" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="{{title}}" />
  {{#description}}<meta property="og:description" content="{{description}}" />{{/description}}
  {{#canonical}}<meta property="og:url" content="{{canonical}}" />{{/canonical}}
  <meta property="og:image" content="{{image}}" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="stylesheet" href="/style.css" />
  <script src="/vendor/htmx.min.js" defer></script>
  <script type="module" src="/code.js"></script>
  <script type="module" src="/lightbox.js"></script>
</head>
{{! Links anywhere in the page load into #content and push the URL; the
    server answers those requests with the page body alone. }}
<body hx-boost="true" hx-target="#content" hx-swap="innerHTML show:window:top">
  <header class="topbar">
    <a class="brand" href="/">{{brand}} <span>docs</span></a>
    <form class="search" action="/search" method="get" role="search">
      <input type="search" name="q" value="{{query}}" placeholder="Search the API…"
             autocomplete="off" aria-label="Search the API"
             hx-get="/search" hx-trigger="input changed delay:150ms, search"
             hx-target="#search-results" hx-swap="innerHTML" hx-push-url="false" />
      <div id="search-results" class="search-results"></div>
    </form>
    {{! Off-site, so not boosted: htmx would fetch GitHub into #content. }}
    <a class="repo" href="https://github.com/nikitapn/LavaUI" hx-boost="false"
       rel="noopener" aria-label="LavaUI on GitHub">
      <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
        <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
      </svg>
      <span>GitHub</span>
    </a>
  </header>

  <div class="shell">
    <nav class="sidebar" aria-label="Documentation">
      <h2>API</h2>
      <ul>
        {{#modules}}<li><a href="{{url}}">{{title}}</a></li>{{/modules}}
      </ul>
      {{#has_articles}}
      <h2>Articles</h2>
      <ul>
        {{#articles}}<li><a href="{{url}}">{{title}}</a></li>{{/articles}}
      </ul>
      {{/has_articles}}
      <h2>Guides</h2>
      <ul>
        {{#guides}}<li><a href="{{url}}">{{title}}</a></li>{{/guides}}
      </ul>
    </nav>

    <main id="content">{{{content}}}</main>
  </div>

  <script>
    // After htmx navigation: close the search dropdown, and scroll to the
    // #anchor a member link points at (a plain swap only scrolls to top).
    document.addEventListener('htmx:afterSettle', (e) => {
      if (e.detail.target.id !== 'content') return;
      document.getElementById('search-results').innerHTML = '';
      const id = decodeURIComponent(location.hash.slice(1));
      const el = id && document.getElementById(id);
      if (el) el.scrollIntoView();
    });
  </script>
</body>
</html>
