# wlroots for the compositor, built as a static subproject with our patches on
# top. `-Dwlroots=system` uses the installed wlroots-0.19 instead. See
# third-party/README.md for why, and for what each patch is.
[wrap-git]
url = https://gitlab.freedesktop.org/wlroots/wlroots.git
revision = 0.19.3
depth = 1
diff_files = wlroots/0001-backend-drm-copy-cursor-on-the-CPU-when-mgpu-cannot-render-it.patch, wlroots/0002-scene-render-only-a-region-for-offscreen-captures.patch
