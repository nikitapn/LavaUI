# lava-index: the per-user file index (see idl/index.npidl).
#
# Built after compositor/ because it borrows two things from it: `nprpc_dep`,
# found there by the same search Package.swift uses, and the URI-list parser,
# which is how GTK's recently-used.xbel spells a path too.

sqlite_dep = dependency('sqlite3', version: '>=3.45')

schema_sql_h = custom_target(
  'schema_sql_h',
  input: 'schema.sql',
  output: 'schema_sql.hpp',
  command: [find_program('python3'), files('scripts/embed_schema.py'), '@INPUT@', '@OUTPUT@'],
)

# Everything but the RPC: crawl, watch, store, rank. A static library so the
# tests link exactly what the daemon runs, and so a tree without nprpc still
# builds and tests it.
index_core = static_library(
  'lava_index_core',
  'src/config.cpp',
  'src/indexer.cpp',
  'src/mounts.cpp',
  'src/ranking.cpp',
  'src/store.cpp',
  'src/xbel.cpp',
  '../compositor/src/uri_list.cpp',
  schema_sql_h,
  include_directories: include_directories('src', '../compositor/src'),
  dependencies: [sqlite_dep],
  override_options: ['warning_level=3'],
)
index_core_dep = declare_dependency(
  link_with: index_core,
  include_directories: include_directories('src'),
  sources: [schema_sql_h],
  dependencies: [sqlite_dep],
)

if nprpc_dep.found()
  # Generated by scripts/gen_stubs.sh from idl/index.npidl, like the
  # compositor's src/gen/lava.cpp.
  executable(
    'lava-index',
    'src/main.cpp',
    'src/gen/index.cpp',
    dependencies: [index_core_dep, nprpc_dep],
    override_options: ['warning_level=3'],
    install: true,
  )
  executable(
    'lava-index-query',
    'src/query_tool.cpp',
    'src/gen/index.cpp',
    dependencies: [nprpc_dep],
    override_options: ['warning_level=3'],
    install: true,
  )
else
  message('lava-index: core only (no nprpc, so no daemon)')
endif

# Headless: ranking is string work.
ranking_test = executable(
  'ranking_test',
  'tests/ranking_test.cpp',
  dependencies: [index_core_dep],
  build_by_default: false,
)
test('index ranking', ranking_test)

# Headless but real: a temporary directory tree, the real indexer thread and
# inotify, and the reader the RPC answers with.
indexer_test = executable(
  'indexer_test',
  'tests/indexer_test.cpp',
  dependencies: [index_core_dep],
  build_by_default: false,
)
test('index crawl and watch', indexer_test, timeout: 60)
