// LavaUI compositor control plane.
//
// The split is deliberate and it is the whole design: **this interface never
// carries pixels**. Draw lists go through `canvas::ipc::DrawArena`, a shared
// mapping the app writes once and the renderer reads in place. What is left
// over — naming resources, wiring an arena up, saying "a frame is ready" — is
// small, request/response shaped, and happens at human rates rather than at
// vertex rates. That is what RPC is good at, and shared-memory NPRPC does a
// round trip in ~7 µs, which against a 16.7 ms frame is not a cost worth
// designing around.
//
// Routing a draw list through here instead would mean copying it (1 MB is
// 0.3 ms, 2% of a frame, for something that should cost nothing) and would
// throw away the property the arena exists to provide.

module lava;

exception FontNotFound {
  path: string;
}

exception ArenaNotFound {
  arenaId: string;
}

/// One raw input event, renderer → app.
///
/// Field-for-field the shape of `canvas::InputEvent`, deliberately: the
/// renderer polls one off GLFW and forwards it without interpreting it. What
/// `x`, `y`, `button` and `mods` mean depends on `kind` — see
/// `InputEventKind` in `draw_command.hpp`, which is the authority for both
/// sides. Keeping the wire struct congruent with the local one is what makes
/// "forward it" a field copy rather than a protocol.
///
/// The one event that does not survive the trip is `FileDrop`: its payload is
/// a list of paths that lives in a side buffer the next drop overwrites, so
/// carrying it needs a call of its own rather than a fixed-size struct.
message InputEvent {
  /// Monotonic per-subscription. The app echoes it back in `InputAck` to say
  /// how far it has got, which is the only way the renderer can tell "the app
  /// is idle" from "the app is behind".
  serial: u32;
  kind: u32;
  x: f32;
  y: f32;
  button: i32;
  mods: i32;
}

/// App → renderer on the same stream: "I have consumed everything through
/// `serial`."
message InputAck {
  serial: u32;
}

interface Compositor {
  // ─── Resources ─────────────────────────────────────────────────────────
  //
  // The renderer owns the GPU, so it owns every id that names something on
  // it. An app can shape text without a device — `canvas::Font` is FreeType
  // and HarfBuzz and nothing else — but the *number* it puts in a
  // `GlyphInstance` has to be one the renderer will resolve to the same face.
  // This is that number, and it is the reason this interface had to exist
  // before anything else: without it the two processes agree on font ids by
  // convention, which works exactly until there are two clients.

  /// Registers a face and returns the id to put in `GlyphInstance.fontId`.
  /// Idempotent per (path, pixelSize) — asking twice gets the same id, so a
  /// client may call it whenever rather than caching carefully.
  u32 RegisterFont(path: in string, pixelSize: in f32) raises(FontNotFound);

  // ─── Surfaces ──────────────────────────────────────────────────────────

  /// Points a window at the shared-memory arena this client publishes frames
  /// into. Until this lands the window has nothing to draw.
  ///
  /// The arena must already exist: the client creates it, the renderer
  /// attaches. That ordering is what makes the arena's capacity and geometry
  /// the producer's business alone.
  void AttachArena(arenaId: in string) raises(ArenaNotFound);

  /// "A frame is committed; come and get it."
  ///
  /// `[unreliable]` — no reply, no ack, no round trip. Correct rather than
  /// merely cheap: the arena's `published` sequence is already the authority
  /// on what is current, so this call carries no information that could be
  /// lost. Dropping one costs a frame of latency, never a frame of content,
  /// and the renderer would coalesce two of them anyway.
  ///
  /// It exists because a shared-memory store wakes nobody. Without it the
  /// renderer has to poll, which is a busy loop pretending to be a frame
  /// clock; with it the renderer blocks until a client actually has
  /// something to show.
  [unreliable] void Present();

  // ─── Input ─────────────────────────────────────────────────────────────

  /// The reverse channel: the renderer owns the window, so it owns the mouse
  /// and the keyboard, and an app that draws into shared memory has no other
  /// way to learn a pointer moved.
  ///
  /// Bidirectional rather than a plain server stream because the two
  /// directions are one conversation. Events go out; the app's `InputAck`
  /// comes back on the same stream, in order, so "how far has the app got"
  /// needs no second channel and no correlation. It also gives NPRPC's
  /// credit-based flow control something to meter: a client that stops
  /// reading stops being sent to, instead of accumulating an unbounded queue
  /// of stale mouse positions in the renderer.
  ///
  /// The first event a subscriber receives is always a synthetic `Resize`
  /// carrying the window's current size. Without it an app could only learn
  /// its size by waiting for the user to drag a border — it would draw at a
  /// guessed size until then, which is exactly the black margin this
  /// interface exists to remove.
  ///
  /// `arenaId` names the surface, not the connection: input follows the
  /// arena a window was attached to, so a client with two windows gets two
  /// subscriptions rather than one multiplexed stream it has to demultiplex.
  ///
  /// No `raises` clause, for now: npidl accepts one on a streaming method but
  /// drops it, generating the servant without `throws` — stream initialization
  /// is getting exception support later. Until then an unknown `arenaId` is
  /// reported the way every other stream failure is: the renderer aborts the
  /// stream and the client's `for try await` throws. Worth revisiting when
  /// `raises` starts working, because "no such arena" is a caller mistake and
  /// deserves to fail at the call rather than one chunk later.
  bidi_stream<InputAck, InputEvent> SubscribeInput(arenaId: in string);
}
