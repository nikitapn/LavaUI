module lava.editor;

message SelectionSnapshot {
  documentId: u64;
  revision: u64;
  startByte: u64;
  endByte: u64;
  text: string;
}

message SelectionEdit {
  startByte: u64;
  endByte: u64;
  text: string;
}

enum EditStatus: u32 { accepted, invalid, alreadySubmitted };

exception ExpiredInvocation { }

/// Scoped to one invocation. The editor commits the entire proposal after
/// the host returns successfully and the snapshot is still current.
interface SelectionCommand {
  SelectionSnapshot ReadSelection(invocation: in u64) raises(ExpiredInvocation);
  /// Ordered, nonoverlapping UTF-8 byte ranges within the selection, measured
  /// from the start of the document. Equal endpoints insert before that byte.
  EditStatus ProposeEdits(invocation: in u64, documentId: in u64, revision: in u64, edits: in vector<SelectionEdit>);
}

message ActionDocument {
  path: string;
  text: string;
  /// Empty during discovery, otherwise the action the user clicked.
  actionId: string;
}

message DocumentLineAction {
  /// Zero-based logical line in this invocation's document snapshot.
  line: u32;
  id: string;
  /// Show a play button beside the line number.
  gutterPlay: boolean;
  /// Clickable text above the line. Empty for a gutter-only action.
  hint: string;
}

/// A problem an extension found, for the Problems panel and the editor's
/// squiggles. Lines are zero-based; columns are zero-based UTF-8 byte
/// offsets within their line.
message ExtensionDiagnostic {
  startLine: u32;
  startColumn: u32;
  endLine: u32;
  endColumn: u32;
  /// 1 error, 2 warning, 3 information, 4 hint — as LSP numbers them.
  severity: u32;
  message: string;
}

interface DocumentActionProvider {
  ActionDocument ReadDocument(invocation: in u64) raises(ExpiredInvocation);
  /// Replaces this provider's gutter buttons and inline hints for the snapshot.
  boolean SetLineActions(invocation: in u64, actions: in vector<DocumentLineAction>);
  /// Replaces this provider's problems for the document — during discovery
  /// only, which runs whenever typing pauses. An empty list clears them.
  boolean SetDiagnostics(invocation: in u64, diagnostics: in vector<ExtensionDiagnostic>);
  boolean ReportResult(invocation: in u64, message: in string);
}

/// What a general command (`"kind": "command"`) sees when it runs: the tab
/// in front, as it is at that moment, unsaved edits included.
message CommandContext {
  /// False for a tab with no text to act on — a preview, a terminal — or a
  /// document over 8 MiB; the fields below about it are then empty or zero.
  hasDocument: boolean;
  documentId: u64;
  revision: u64;
  /// Empty for a buffer that was never saved.
  path: string;
  /// The editor's language ID: `swift`, `json`, `plain`.
  language: string;
  /// The open folder, empty when there is none.
  projectRoot: string;
  text: string;
  /// UTF-8 byte offsets into `text`. Equal when nothing is selected.
  selectionStartByte: u64;
  selectionEndByte: u64;
  caretByte: u64;
}

/// Scoped to one invocation. Everything asked for is done after the host
/// returns successfully, in the order: edits, files opened, message.
interface CommandHost {
  CommandContext ReadContext(invocation: in u64) raises(ExpiredInvocation);
  /// Ordered, nonoverlapping UTF-8 byte ranges anywhere in the document,
  /// applied as one undo step, and only if the document has not changed
  /// since `ReadContext`. One batch per invocation.
  EditStatus ProposeEdits(invocation: in u64, documentId: in u64, revision: in u64, edits: in vector<SelectionEdit>);
  /// Opens a file in a tab. A relative path is taken from the project root,
  /// or the document's folder without one. `line` is one-based; 0 leaves
  /// the caret where the tab had it.
  boolean OpenFile(invocation: in u64, path: in string, line: in u32);
  /// A line for the notice bar. The last one wins.
  boolean ShowMessage(invocation: in u64, message: in string);
  /// Replaces this command's problems for the file at `path` (absolute, or
  /// relative as for OpenFile). An empty list clears them. A linter run
  /// publishes each file it looked at; they stay until it runs again or the
  /// extensions are reloaded.
  boolean PublishDiagnostics(invocation: in u64, path: in string, diagnostics: in vector<ExtensionDiagnostic>);
}

message PreviewDocument {
  path: string;
  text: string;
}

/// Read-only snapshot of the source buffer, including unsaved edits.
interface MarkdownPreviewProvider {
  PreviewDocument ReadDocument(invocation: in u64) raises(ExpiredInvocation);
  boolean SetMarkdown(invocation: in u64, markdown: in string);
}

/// V1 draw lists use the little-endian DrawCommand and GlyphInstance layout
/// from canvas. Font slot zero is the viewport face. Images are frame-local.
enum SurfaceInputKind: u32 { press, drag, release, motion, leave, wheel, key, character, focus, cancel };
message SurfaceInput {
  kind: SurfaceInputKind;
  viewportId: u64;
  frameId: u64;
  x: f32; y: f32; dx: f32; dy: f32;
  code: i32; mods: i32; repeatKey: boolean; text: string;
}
message SurfaceViewport {
  id: u64; width: f32; height: f32; scale: f32;
  fontPath: string; fontSha256: string; face: u32; size26_6: u32; rasterFlags: u32;
}
message SurfaceRequest {
  viewport: SurfaceViewport;
  frameId: u64;
  state: vector<u8>;
  events: vector<SurfaceInput>;
}
message SurfaceImage {
  id: u32; width: u32; height: u32;
  rgba: vector<u8>;
}
message SurfaceFrame {
  viewportId: u64; frameId: u64;
  commands: vector<u8>; glyphs: vector<u8>;
  images: vector<SurfaceImage>;
  state: vector<u8>;
}
interface EmbeddedSurfaceProvider {
  SurfaceRequest ReadRequest(invocation: in u64) raises(ExpiredInvocation);
  PreviewDocument ReadDocument(invocation: in u64) raises(ExpiredInvocation);
  boolean SubmitFrame(invocation: in u64, frame: in SurfaceFrame);
}
