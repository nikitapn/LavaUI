#version 450

// Local workgroup size
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Particle data structure
struct Particle {
    vec2 position;
    vec2 velocity;
    float mass;
    float invMass;
    vec2 force;
    float padding; // For alignment
};

// Collision pair structure
struct CollisionPair {
    uint particleA;
    uint particleB;
    vec2 normal;        // collision normal (from A to B)
    float penetration;  // overlap distance
};

// Storage buffers
layout(std140, binding = 0) restrict buffer ParticleBuffer {
    Particle particles[];
};

layout(std430, binding = 1) restrict buffer CollisionPairBuffer {
    CollisionPair collisionPairs[];
};

layout(std430, binding = 2) restrict buffer CollisionCountBuffer {
    uint collisionCount;
};

// Uniform buffer for simulation parameters
layout(binding = 3) uniform SimulationParams {
    vec2 gravity;
    vec2 worldSize;
    float deltaTime;
    float restitution;
    float particleRadius;
    uint particleCount;
    uint maxCollisionPairs;
    uint substeps;
    uint currentSubstep;
};

// Constants
const float EPSILON = 1e-6;

void main() {
    uint i = gl_GlobalInvocationID.x;
    
    // Bounds check
    if (i >= particleCount) {
        return;
    }
    
    Particle particleA = particles[i];
    
    // Check particle i against all particles j > i to avoid duplicates
    for (uint j = i + 1; j < particleCount; j++) {
        Particle particleB = particles[j];
        
        // Calculate distance between particles
        vec2 relativePos = particleB.position - particleA.position;
        float distance = length(relativePos);
        float minDistance = 2.0 * particleRadius;
        
        // Check for collision
        if (distance < minDistance && distance > EPSILON) {
            // Collision detected - add to pairs buffer
            uint pairIndex = atomicAdd(collisionCount, 1);
            
            // Make sure we don't overflow the buffer
            if (pairIndex < maxCollisionPairs) {
                vec2 normal = relativePos / distance;
                float penetration = minDistance - distance;
                
                collisionPairs[pairIndex].particleA = i;
                collisionPairs[pairIndex].particleB = j;
                collisionPairs[pairIndex].normal = normal;
                collisionPairs[pairIndex].penetration = penetration;
            }
        }
    }
}