; Ours to edit: a grammar upgrade does not change it. Captures are HighlightName
; names; the last pattern that captures a node wins, and a node inside
; another overrides it for its own extent (HighlightQuery.swift has the engine).

(identifier) @variable

((identifier) @constant
 (#match? @constant "^[A-Z][A-Z\\d_]*$"))

"break" @keyword
